# ====================================================================
# AVT - FLOWER MERCHANT & COMMISSION AGENT
# Production Environment Configuration Template
# ====================================================================

# Core Django Settings
DJANGO_SECRET_KEY=generate-a-strong-random-50-char-secret-key-for-production
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,http://127.0.0.1:8002

# Database Connection (SQLite default if empty; PostgreSQL for production)
# Example: postgresql://dbuser:dbpassword@postgres:5432/avt_flower_db
DATABASE_URL=

# SSL Enforcement (Set to True when HTTPS is enabled behind Nginx / reverse proxy)
SECURE_SSL_REDIRECT=False

# System Governance (Contact number displayed on PENDING approval screen)
ADMIN_CONTACT_NUMBER=

# Server Binding
PORT=8002
HOST=0.0.0.0

# ====================================================================
# Google Cloud OAuth 2.0 (Drive & Sheets Multi-Tenant Provisioning)
# ====================================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8002/super-admin/google/callback/
GOOGLE_DRIVE_FOLDER_NAME="AVT Flower Market - Merchant Sheets"
# 32-byte url-safe base64 key generated via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GOOGLE_OAUTH_ENCRYPTION_KEY=
GOOGLE_SHEET_SHARE_VIEWER=False

